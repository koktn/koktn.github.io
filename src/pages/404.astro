---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="ページが見つかりません" description="指定されたページは見つかりませんでした">
  <section class="not-found page-width">
    <p class="error-code">404</p>
    <h1>ページが見つかりません</h1>
    <p>URLが変更されたか、ページが削除された可能性があります。</p>
    <a class="button-link" href="/">ホームへ戻る</a>
  </section>
</BaseLayout>
