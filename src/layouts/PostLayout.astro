---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import type { BlogPost } from '../utils/posts';
import { formatDate, postPath, taxonomySlug } from '../utils/posts';

interface Props {
  post: BlogPost;
  headings: MarkdownHeading[];
  previous?: BlogPost;
  next?: BlogPost;
}

const { post, headings, previous, next } = Astro.props;
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const canonicalUrl = new URL(postPath(post), Astro.site);
const shareUrl = new URL('https://x.com/intent/tweet');
shareUrl.searchParams.set('text', post.data.title);
shareUrl.searchParams.set('url', canonicalUrl.href);
---

<BaseLayout title={post.data.title} description={post.data.description} image={post.data.image} type="article">
  <article class="article-shell">
    <header class="article-header">
      {post.data.draft && <span class="draft-badge">下書きプレビュー</span>}
      <p class="eyebrow"><a href={`/categories/${taxonomySlug(post.data.category)}/`}>{post.data.category}</a></p>
      <h1>{post.data.title}</h1>
      <p class="article-description">{post.data.description}</p>
      <div class="article-meta">
        <time datetime={post.data.publishedAt.toISOString()}>公開日 {formatDate(post.data.publishedAt)}</time>
        {post.data.updatedAt && <time datetime={post.data.updatedAt.toISOString()}>更新日 {formatDate(post.data.updatedAt)}</time>}
      </div>
      <ul class="tag-list" aria-label="タグ">
        {post.data.tags.map((tag) => <li><a href={`/tags/${taxonomySlug(tag)}/`}>#{tag}</a></li>)}
      </ul>
      <a
        class="x-share-link"
        href={shareUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`「${post.data.title}」をXでシェア（新しいタブで開きます）`}
      >
        <svg aria-hidden="true" viewBox="0 0 24 24">
          <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24h-6.657l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231 5.45-6.231Zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77Z"></path>
        </svg>
        Xでシェア
      </a>
    </header>

    {toc.length > 0 && (
      <details class="toc" open>
        <summary>目次</summary>
        <ul>
          {toc.map((heading) => (
            <li class:list={{ nested: heading.depth === 3 }}><a href={`#${heading.slug}`}>{heading.text}</a></li>
          ))}
        </ul>
      </details>
    )}

    <div class="prose"><slot /></div>

    <nav class="post-navigation" aria-label="前後の記事">
      {previous ? <a href={postPath(previous)}><span>前の記事</span>{previous.data.title}</a> : <span />}
      {next && <a class="next" href={postPath(next)}><span>次の記事</span>{next.data.title}</a>}
    </nav>
  </article>
</BaseLayout>
